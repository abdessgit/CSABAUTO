# Configuration CS AB AUTO - Modèle de variables d'environnement
# Copiez ce fichier vers .env.local pour surcharger les valeurs locales

APP_ENV=dev
APP_SECRET=change_this_secret_in_production
APP_SHARE_DIR=var/share

# Base de données PostgreSQL
DATABASE_URL="postgresql://app:password@127.0.0.1:5433/app?serverVersion=16&charset=utf8"

# Configuration CORS
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# Clés JWT
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=your_jwt_passphrase_here

# Informations Garage / Entreprise
COMPANY_NAME="CSAB AUTO"
COMPANY_ADDRESS="3 Bis Rue Albert Thomas, 62410 Meurchin"
COMPANY_PHONE="06 63 40 76 94"
COMPANY_EMAIL="contact@csabauto.fr"
COMPANY_SIRET="851 442 152 00019"

# Envoi d'e-mails (Mailer)
# En dev avec Mailpit : smtp://127.0.0.1:1025
# En dev avec Mailtrap : smtp://user:pass@sandbox.smtp.mailtrap.io:2525
# En production (ex. Brevo, Sendgrid, Gmail SMTP) :
MAILER_DSN=smtp://127.0.0.1:1025
MAILER_FROM="no-reply@csabauto.fr"

# URL du frontend pour les liens de confirmation
FRONTEND_URL="http://localhost:5173"
